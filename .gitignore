# Common Lisp .gitignore (autogenerated, needs review)

# Compiled files
*.fasl
*.x86f
*.dx86f
*.lx86f
*.fx86f
*.sse2f
*.sparcf
*.ppcf
*.dfsl
*.dfasl
*.fas
*.lib
*.mem
*.out

# Slime and REPL history
.slime-history
.repl-history

# ASDF output
output/
build/
bin/
lib/

# Quicklisp local projects
local-projects/

# SBCL core files
*.core

# Temporary files
*~
*.swp
*.bak

# Others
.direnv

metaModel.json
metaModel.schema.json

# Local scratch
tmp/

# Sandbox artifacts. The bubblewrap isolation used for agent sessions bind-mounts
# /dev/null over these paths, so they appear as character devices in the repo
# root rather than files. They are never real project content -- do not commit.
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.gitmodules
.ripgreprc
.mcp.json
.claude/commands
.claude/hooks
.claude/launch.json
.claude/loop.md
.claude/output-styles
.claude/routines
.claude/scheduled_tasks.json
.claude/settings.json
.claude/skills
.claude/workflows
.claude/settings.local.json
.claude/.cc-writes/

# Editor state
.idea
.vscode

# Built executable
/clef
