;;; Probe 2: does SBCL detect heap->arena pointers, and what happens if you
;;; read arena memory after rewind? Use a global so nothing is optimized away.
(defglobal **holder** nil)

(format t "~&=== heap->arena detection (global holder) ===~%")
(let ((a (sb-vm:new-arena (* 1024 1024))))
  (sb-vm:with-arena (a)
    (setf **holder** (make-list 10 :initial-element 7)))
  (format t "~&  holder points to arena? ~s~%" (sb-vm:points-to-arena **holder**))
  (let ((found (sb-vm:c-find-heap->arena a)))
    (format t "~&  c-find-heap->arena: ~s~%" found)
    (when found (format t "~&  count: ~a~%" (length found))))
  (format t "~&  --- now rewinding with a live reference outstanding ---~%")
  (finish-output)
  (sb-vm:rewind-arena a)
  (format t "~&  survived rewind. reading escaped data:~%")
  (finish-output)
  (format t "~&  contents: ~s~%" (ignore-errors **holder**))
  (finish-output)
  (format t "~&  length: ~s~%" (ignore-errors (length **holder**)))
  (finish-output)
  (format t "~&  elements: ~s~%" (ignore-errors (copy-list **holder**)))
  (finish-output))
(format t "~&done~%")
