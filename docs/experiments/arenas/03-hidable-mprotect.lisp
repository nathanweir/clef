;;; Probe 3: does :hidable + hide-arena turn use-after-free into a hard trap?
(defglobal **holder** nil)

(format t "~&=== hidable arena ===~%")
(let ((a (sb-vm:new-arena (* 1024 1024) (* 1024 1024) 7 :hidable t)))
  (format t "~&  created hidable: ~s~%" a)
  (sb-vm:with-arena (a)
    (setf **holder** (make-list 5 :initial-element 99)))
  (format t "~&  pre-hide read: ~s~%" **holder**)
  (finish-output)
  (sb-vm:hide-arena a)
  (format t "~&  hidden. attempting read (expect trap/error):~%")
  (finish-output)
  (handler-case (format t "~&  READ SUCCEEDED: ~s~%" (copy-list **holder**))
    (error (e) (format t "~&  TRAPPED: ~a: ~a~%" (type-of e) e))
    (serious-condition (e) (format t "~&  SERIOUS: ~a~%" (type-of e))))
  (finish-output)
  (sb-vm:unhide-arena a)
  (format t "~&  unhidden, read: ~s~%" (copy-list **holder**))
  (setf **holder** nil)
  (sb-vm:destroy-arena a))
(format t "~&done~%")
